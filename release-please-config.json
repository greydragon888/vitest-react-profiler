{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "pull-request-title-pattern": "release: v${version}",
  "changelog-sections": [
    { "type": "feat", "section": "Added" },
    { "type": "fix", "section": "Fixed" },
    { "type": "perf", "section": "Changed" },
    { "type": "build", "section": "Changed" },
    { "type": "revert", "section": "Changed" },
    { "type": "refactor", "section": "Refactoring", "hidden": true },
    { "type": "docs", "section": "Documentation", "hidden": true },
    { "type": "style", "section": "Styles", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "ci", "section": "Continuous Integration", "hidden": true },
    { "type": "chore", "section": "Chores", "hidden": true }
  ],
  "exclude-paths": ["package-lock.json"],
  "packages": {
    ".": {
      "package-name": "vitest-react-profiler",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "generic", "path": "sonar-project.properties" },
        { "type": "generic", "path": "CLAUDE.md" }
      ]
    }
  }
}
