{
  "name": "vitest-react-profiler",
  "version": "1.12.0",
  "description": "Performance testing utilities for React components and hooks with sync/async update tracking in Vitest",
  "keywords": [
    "vitest",
    "react",
    "testing",
    "profiler",
    "performance",
    "hooks",
    "async",
    "render",
    "benchmark",
    "matchers",
    "react-hooks",
    "performance-testing",
    "render-tracking",
    "component-testing",
    "hook-testing"
  ],
  "homepage": "https://github.com/greydragon888/vitest-react-profiler#readme",
  "bugs": {
    "url": "https://github.com/greydragon888/vitest-react-profiler/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greydragon888/vitest-react-profiler.git"
  },
  "license": "MIT",
  "author": {
    "name": "Oleg Ivanov",
    "email": "greydragon888@gmail.com",
    "url": "https://github.com/greydragon888"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": [
    "./src/matchers/index.ts",
    "./src/auto-setup.ts",
    "./dist/index.js",
    "./dist/index.cjs"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --config vitest.config.unit.mts",
    "test:coverage": "vitest run --coverage --config vitest.config.unit.mts",
    "test:mutation": "stryker run",
    "test:mutation:report": "open reports/mutation-report.html",
    "test:properties": "NODE_OPTIONS='--max-old-space-size=4096' vitest run --config vitest.config.properties.mts",
    "test:bench": "NODE_OPTIONS='--expose-gc --max-old-space-size=16384' vitest bench --config vitest.config.bench.mts",
    "test:stress": "NODE_OPTIONS='--expose-gc' vitest run --config vitest.config.stress.mts",
    "test:examples": "npm run test:run --workspaces --if-present",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.node.json",
    "lint": "eslint . --ext .ts,.tsx --fix",
    "lint:types": "attw --pack .",
    "lint:package": "publint",
    "lint:unused": "knip",
    "lint:duplicates": "jscpd src/",
    "size": "size-limit",
    "lint:md": "markdownlint \"**/*.md\" --ignore node_modules",
    "lint:md:fix": "markdownlint \"**/*.md\" --ignore node_modules --fix",
    "bundle:analyze": "npm run build && npx @codecov/bundle-analyzer ./dist --bundle-name=vitest-react-profiler",
    "sonar": "dotenv -- sonar-scanner-npm",
    "sonar:debug": "dotenv -- sonar-scanner-npm -Dsonar.log.level=DEBUG -Dsonar.verbose=true",
    "sonar:local": "npm run typecheck && npm run test:coverage && npm run sonar",
    "prepare": "node -e \"try { require('husky') } catch (e) {}\"",
    "prepublishOnly": "npm run typecheck && npm run test:coverage && npm run build && npm run lint:types && npm run lint:package && npm run lint:unused"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "vitest": ">=1.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@codecov/bundle-analyzer": "2.0.1",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "@fast-check/vitest": "0.5.0",
    "@size-limit/file": "13.1.1",
    "@size-limit/preset-small-lib": "13.1.1",
    "@sonar/scan": "5.0.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/typescript-checker": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/eslint-plugin": "1.6.27",
    "dotenv-cli": "11.0.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsdoc": "64.5.0",
    "eslint-plugin-no-only-tests": "3.4.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-regexp": "3.3.0",
    "eslint-plugin-security": "4.0.1",
    "eslint-plugin-sonarjs": "4.2.1",
    "eslint-plugin-unicorn": "74.0.0",
    "fast-check": "4.10.0",
    "husky": "9.1.7",
    "jscpd": "5.2.1",
    "jsdom": "30.0.1",
    "knip": "6.35.1",
    "lint-staged": "17.5.1",
    "markdownlint-cli": "0.49.1",
    "prettier": "3.9.6",
    "publint": "0.3.24",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "size-limit": "13.1.1",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.11"
  },
  "workspaces": [
    "examples/*"
  ],
  "overrides": {
    "qs": ">=6.16.0"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true,
    "unrs-resolver": true
  }
}
